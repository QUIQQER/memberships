<?xml version="1.0" encoding="UTF-8"?>
<database>

    <global>
        <table name="quiqqer_memberships">
            <!-- basic fields -->
            <field type="bigint" autoincrement="true" primary="true">id</field>
            <field type="text">title</field>
            <field type="text" nullable="true">description</field>
            <field type="text" nullable="true">content</field>
            <field type="string" length="255">duration</field>
            <field type="text" nullable="true">groupIds</field>
            <field type="datetime">createDate</field>
            <field type="string" length="50">createUser</field>
            <field type="datetime" nullable="true" default="null">editDate</field>
            <field type="string" length="50" nullable="true">editUser</field>
            <field type="boolean" default="0">autoExtend</field>

            <!-- quiqqer/order fields -->
            <field type="string" length="255" nullable="true">paymentInterval</field>
        </table>

        <table name="quiqqer_memberships_users">
            <!-- basic fields -->
            <field type="bigint" autoincrement="true" primary="true">id</field>
            <field type="bigint">membershipId</field>
            <field type="string" length="50">userId</field>
            <field type="datetime">addedDate</field>
            <field type="datetime" nullable="true" default="null">beginDate</field>
            <field type="datetime" nullable="true" default="null">endDate</field>
            <field type="smallint" default="0">extendCounter</field>
            <field type="datetime" nullable="true" default="null">cancelDate</field>
            <field type="datetime" nullable="true" default="null">cancelEndDate</field>
            <field type="boolean" default="0">cancelled</field>
            <field type="string" length="255" default="0">cancelStatus</field>
            <field type="boolean" default="0">archived</field>
            <field type="datetime" nullable="true" default="null">archiveDate</field>
            <field type="string" length="255" nullable="true">archiveReason</field>
            <field type="text" nullable="true">history</field>
            <field type="text" nullable="true">extraData</field>

            <!-- quiqqer/products fields -->
            <field type="bigint" nullable="true">productId</field>

            <!-- quiqqer/contracts fields -->
            <field type="bigint" nullable="true">contractId</field>

            <index>membershipId,userId,archived</index>
            <index>userId,archived</index>
            <index>membershipId,archived,productId</index>
            <index>contractId</index>
        </table>
    </global>

</database>
