<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/memberships" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/memberships" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="membership.management">
                <title>Membership management</title>
                <description>
                    Manages time-limited or renewable memberships with group-based access and lifecycle histories.
                </description>
            </capability>

            <capability id="membership.self-service">
                <title>Membership self-service</title>
                <description>
                    Lets users view memberships and verify, revoke or complete cancellation requests.
                </description>
            </capability>

            <capability id="commerce.membership-products">
                <title>Membership products</title>
                <description>
                    Creates membership-linked products and grants purchased memberships after successful orders.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/memberships/bin/images/Logo.jpg"/>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/memberships/bin/images/preview/Frontend_Profile.png"/>
            <image src="URL_OPT_DIR/quiqqer/memberships/bin/images/preview/Backend_List.png"/>
            <image src="URL_OPT_DIR/quiqqer/memberships/bin/images/preview/Backend_Membership.png"/>
            <image src="URL_OPT_DIR/quiqqer/memberships/bin/images/preview/Backend_Membership_History.png"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/memberships]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/memberships/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/memberships/wikis/home]]></wiki>
        </support>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[PCSG QL-1.0]]></license>
            <license><![CDATA[CC BY-NC-SA 4.0]]></license>
        </copyright>

        <languages>
            <language>de</language>
            <language>en</language>
        </languages>

        <provider>
            <mcp src="\QUI\Memberships\MCP\Provider"/>
        </provider>

    </package>
</quiqqer>
